<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <add key="listenIp" value="127.0.0.1" />
    <add key="listenPort" value="8080" />
    <add key="backlog" value="10" />
    <add key="maxPayloadBytes" value="1048576" />
    <add key="joinTimeoutMilliseconds" value="5000" />
    <add key="reservationDelaySeconds" value="30" />
    <add key="approvalIntervalMilliseconds" value="1000" />
    <add key="imagesDirectory" value="imagenes" />
    <add key="maxFileBytes" value="10485760" />
    <add key="fileBlockBytes" value="32768" />
  </appSettings>
</configuration>
